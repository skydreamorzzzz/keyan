# Local agent/editor state
.agents/
.codex/
.claude/

# Python/runtime caches
__pycache__/
*.py[cod]
.pytest_cache/

# Raw data and large downloaded inputs
data/finqa/
data/*.pdf
data/*.pdf:Zone.Identifier
data/multihiertt/raw/*.parquet
data/multihiertt/processed/multihiertt_*.jsonl
data/multihiertt/processed/multihiertt_case_memory_train.json
data/multihiertt/processed/multihiertt_case_emb.npy
