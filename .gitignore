# Generated caches and embeddings
pilot/output/*cache*.jsonl
pilot/output/*.npy
pilot/output/paper_*.txt
pilot/stage2/output/*cache*.jsonl
pilot/stage2_official/output/*cache*.jsonl

# Logs and local environment
*.log
.env
.env.*

# This environment exposes .git as a read-only placeholder, so local git state
# may be stored here for the initial push.
.gitreal/
